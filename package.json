{
  "name": "@redfoxxo/perch",
  "version": "1.1.0",
  "description": "MCP server for desktop control on Linux and Windows: five compact tools over computer-use-linux and open-computer-use",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "desktop-automation",
    "accessibility",
    "computer-use",
    "linux",
    "windows"
  ],
  "homepage": "https://github.com/RedFoxxo/perch#readme",
  "bugs": {
    "url": "https://github.com/RedFoxxo/perch/issues"
  },
  "type": "module",
  "bin": {
    "perch": "build/index.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@agent-sh/computer-use-linux": "0.7.53",
    "@opensymph/open-computer-use": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "files": [
    "build/**/*.js",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedFoxxo/perch.git"
  },
  "license": "MIT"
}
